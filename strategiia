from freqtrade.strategy import IStrategy, informative
from freqtrade.persistence import Trade
from pandas import DataFrame
from datetime import datetime, timedelta
from typing import Optional
import numpy as np
import pandas as pd
import talib.abstract as ta
import freqtrade.vendor.qtpylib.indicators as qtpylib

"""
VanTharpTrend Strategy — inspired by Van K. Tharp "Trade Your Way to Financial Freedom"
and "Definitive Guide to Position Sizing".

Core principles applied:
  1. R-multiples  — every SL = 1R, every TP = multiple of R
  2. Expectancy   — enter only when setup has positive expectancy
  3. ATR-based stops — "volatility stop", not arbitrary %
  4. Trend filter — only trade WITH the trend (EMA200 on higher TF)
  5. Position sizing hook — ROI table mirrors 3R / 5R targets
  6. Low-risk entry — pullback to a moving average in an uptrend

Tested on:
  freqtrade >= 2024.1
  Python 3.11
  ta-lib 0.4.28
"""


class VanTharpTrend(IStrategy):
    # ─── Strategy metadata ────────────────────────────────────────────────────
    INTERFACE_VERSION = 3
    can_short = False
    timeframe = "4h"

    # ─── Startup candles (need history for EMA200 + higher TF) ───────────────
    startup_candle_count: int = 250

    # ─── ROI — Van Tharp style: 1R stop, target 3R and 5R ────────────────────
    # These are fallback exits; primary exit is via custom_exit / stoploss_on_exchange
    minimal_roi = {
        "0":   0.15,   # 5R  – let winners run
        "720": 0.09,   # 3R  – after 30 days minimum
        "1440": 0.03,  # 1R  – clear the trade if still alive after 60 days
    }

    # ─── Stoploss — ATR-based, overridden in custom_stoploss ─────────────────
    stoploss = -0.05          # fallback hard stop (5%)
    trailing_stop = False     # we manage stops manually via custom_stoploss

    # ─── Order config ─────────────────────────────────────────────────────────
    order_types = {
        "entry":            "limit",
        "exit":             "limit",
        "stoploss":         "market",
        "stoploss_on_exchange": True,
    }
    order_time_in_force = {
        "entry": "GTC",
        "exit":  "GTC",
    }

    # ─── Process only new candles ─────────────────────────────────────────────
    process_only_new_candles = True

    # ─── Plot config ──────────────────────────────────────────────────────────
    plot_config = {
        "main_plot": {
            "ema21":  {"color": "#f5a623"},
            "ema55":  {"color": "#7ed321"},
            "ema200": {"color": "#d0021b"},
        },
        "subplots": {
            "ATR": {
                "atr": {"color": "#9b59b6"},
            },
            "RSI": {
                "rsi": {"color": "#3498db"},
            },
            "ADX": {
                "adx": {"color": "#e74c3c"},
            },
        },
    }

    # ═══════════════════════════════════════════════════════════════════════════
    #  INFORMATIVE — daily trend filter (higher timeframe confirmation)
    # ═══════════════════════════════════════════════════════════════════════════
    @informative("1d")
    def populate_indicators_1d(self, dataframe: DataFrame, metadata: dict) -> DataFrame:
        dataframe["ema200_1d"] = ta.EMA(dataframe, timeperiod=200)
        dataframe["trend_up_1d"] = dataframe["close"] > dataframe["ema200_1d"]
        return dataframe

    # ═══════════════════════════════════════════════════════════════════════════
    #  INDICATORS  (4h base timeframe)
    # ═══════════════════════════════════════════════════════════════════════════
    def populate_indicators(self, dataframe: DataFrame, metadata: dict) -> DataFrame:

        # ── Trend EMAs ────────────────────────────────────────────────────────
        dataframe["ema21"]  = ta.EMA(dataframe, timeperiod=21)
        dataframe["ema55"]  = ta.EMA(dataframe, timeperiod=55)
        dataframe["ema200"] = ta.EMA(dataframe, timeperiod=200)

        # ── ATR — Van Tharp volatility unit ───────────────────────────────────
        dataframe["atr"]    = ta.ATR(dataframe, timeperiod=14)
        # Store ATR multiple for stop distance (1.5 × ATR below entry)
        dataframe["sl_distance"] = dataframe["atr"] * 1.5

        # ── RSI — overbought/oversold filter ──────────────────────────────────
        dataframe["rsi"]    = ta.RSI(dataframe, timeperiod=14)

        # ── ADX — trend strength (Van Tharp: only trade strong trends) ────────
        adx = ta.ADX(dataframe, timeperiod=14)
        dataframe["adx"]    = adx

        # ── Bollinger Bands — squeeze / expansion ─────────────────────────────
        bollinger = qtpylib.bollinger_bands(
            qtpylib.typical_price(dataframe), window=20, stds=2
        )
        dataframe["bb_upper"] = bollinger["upper"]
        dataframe["bb_lower"] = bollinger["lower"]
        dataframe["bb_mid"]   = bollinger["mid"]

        # ── Volume spike — confirms institutional participation ────────────────
        dataframe["vol_ma"] = ta.SMA(dataframe["volume"], timeperiod=20)
        dataframe["vol_spike"] = dataframe["volume"] > dataframe["vol_ma"] * 1.3

        # ── Pullback detection — price touched EMA21 or EMA55 ─────────────────
        dataframe["near_ema21"] = (
            (dataframe["low"] <= dataframe["ema21"] * 1.01) &
            (dataframe["close"] >= dataframe["ema21"] * 0.99)
        )
        dataframe["near_ema55"] = (
            (dataframe["low"] <= dataframe["ema55"] * 1.01) &
            (dataframe["close"] >= dataframe["ema55"] * 0.99)
        )

        # ── Engulfing candle — entry trigger ──────────────────────────────────
        dataframe["bullish_engulfing"] = (
            (dataframe["close"] > dataframe["open"]) &                         # green candle
            (dataframe["close"].shift(1) < dataframe["open"].shift(1)) &       # prev red
            (dataframe["close"] > dataframe["open"].shift(1)) &                # engulfs body
            (dataframe["open"] < dataframe["close"].shift(1))
        ).astype(int)

        return dataframe

    # ═══════════════════════════════════════════════════════════════════════════
    #  ENTRY SIGNAL  — Van Tharp "Low Risk Entry"
    #
    #  Checklist:
    #    1. Daily trend is UP (price > EMA200 on 1d)
    #    2. 4h price is above EMA55 (medium trend UP)
    #    3. EMA21 > EMA55 > EMA200 (all aligned)
    #    4. ADX > 20 (trend is strong enough)
    #    5. RSI is not overbought (< 70)
    #    6. Price pulled back to EMA21 or EMA55 (low-risk entry point)
    #    7. Bullish engulfing candle confirms reversal
    #    8. Volume confirms the move
    # ═══════════════════════════════════════════════════════════════════════════
    def populate_entry_trend(self, dataframe: DataFrame, metadata: dict) -> DataFrame:

        trend_aligned = (
            (dataframe["ema21"]  > dataframe["ema55"]) &
            (dataframe["ema55"]  > dataframe["ema200"])
        )

        conditions_long = (
            # 1. Higher-TF daily trend is UP
            (dataframe["trend_up_1d"] == True) &                 # noqa: E712

            # 2. Medium-term trend UP
            (dataframe["close"] > dataframe["ema55"]) &

            # 3. All EMAs aligned bullishly
            trend_aligned &

            # 4. Trend strength
            (dataframe["adx"] > 20) &

            # 5. Not overbought
            (dataframe["rsi"] < 70) &

            # 6. Pullback to dynamic support
            (dataframe["near_ema21"] | dataframe["near_ema55"]) &

            # 7. Confirmation candle
            (dataframe["bullish_engulfing"] == 1) &

            # 8. Volume confirmation
            dataframe["vol_spike"] &

            # Safety — price above lower BB
            (dataframe["close"] > dataframe["bb_lower"]) &

            # No gaps / clean candle
            (dataframe["volume"] > 0)
        )

        dataframe.loc[conditions_long, "enter_long"]  = 1
        dataframe.loc[conditions_long, "enter_tag"]   = "vt_pullback_ema"

        return dataframe

    # ═══════════════════════════════════════════════════════════════════════════
    #  EXIT SIGNAL  — exit when trend breaks down
    # ═══════════════════════════════════════════════════════════════════════════
    def populate_exit_trend(self, dataframe: DataFrame, metadata: dict) -> DataFrame:

        conditions_exit = (
            # EMA21 crosses below EMA55 — trend reversal
            (qtpylib.crossed_below(dataframe["ema21"], dataframe["ema55"])) |

            # RSI overbought exhaustion
            (dataframe["rsi"] > 80) |

            # Daily trend flipped
            (dataframe["trend_up_1d"] == False)    # noqa: E712
        )

        dataframe.loc[conditions_exit, "exit_long"] = 1
        dataframe.loc[conditions_exit, "exit_tag"]  = "vt_trend_exit"

        return dataframe

    # ═══════════════════════════════════════════════════════════════════════════
    #  CUSTOM STOPLOSS — ATR-based (1.5 × ATR trailing)
    #
    #  Van Tharp: "Your stop should be placed at a point where
    #  the original premise is no longer valid."
    #  Here: 1.5 × ATR below recent swing low.
    # ═══════════════════════════════════════════════════════════════════════════
    def custom_stoploss(
        self,
        pair: str,
        trade: Trade,
        current_time: datetime,
        current_rate: float,
        current_profit: float,
        after_fill: bool,
        **kwargs,
    ) -> Optional[float]:

        dataframe, _ = self.dp.get_analyzed_dataframe(pair, self.timeframe)
        if dataframe is None or len(dataframe) == 0:
            return None

        last = dataframe.iloc[-1]
        atr  = last["atr"]

        if pd.isna(atr) or atr <= 0:
            return None

        # ATR stop: 1.5 × ATR below current price
        atr_stop_price = current_rate - (atr * 1.5)

        # Once in profit > 1R (~3%), trail the stop to break-even
        if current_profit > 0.03:
            breakeven_price = trade.open_rate * (1 + trade.fee_open + trade.fee_close)
            atr_stop_price  = max(atr_stop_price, breakeven_price)

        # Once in profit > 2R (~6%), use a tighter 1×ATR trail
        if current_profit > 0.06:
            atr_stop_price = max(atr_stop_price, current_rate - atr)

        # Convert to relative stoploss for freqtrade (negative float)
        stoploss_value = (atr_stop_price - trade.open_rate) / trade.open_rate
        return max(stoploss_value, -0.25)   # never more than -25% hard floor

    # ═══════════════════════════════════════════════════════════════════════════
    #  CUSTOM EXIT — Van Tharp R-multiple profit protection
    # ═══════════════════════════════════════════════════════════════════════════
    def custom_exit(
        self,
        pair: str,
        trade: Trade,
        current_time: datetime,
        current_rate: float,
        current_profit: float,
        **kwargs,
    ) -> Optional[str]:

        # Estimate 1R from ATR at trade open
        dataframe, _ = self.dp.get_analyzed_dataframe(pair, self.timeframe)
        if dataframe is None or len(dataframe) < 2:
            return None

        # ── Time-based exit: kill trades stuck near zero after 30 days ─────────
        trade_duration = (current_time - trade.open_date_utc).days
        if trade_duration > 30 and abs(current_profit) < 0.01:
            return "vt_time_stop_30d"

        # ── Partial-exit simulation via full exit at 5R (15%) ─────────────────
        if current_profit >= 0.15:
            return "vt_5R_target"

        return None

    # ═══════════════════════════════════════════════════════════════════════════
    #  POSITION SIZING helper (informational — printed in logs)
    #  Van Tharp: risk 1% of account per trade.
    #  freqtrade handles sizing via max_open_trades + stake_amount in config.
    # ═══════════════════════════════════════════════════════════════════════════
    def confirm_trade_entry(
        self,
        pair: str,
        order_type: str,
        amount: float,
        rate: float,
        time_in_force: str,
        current_time: datetime,
        entry_tag: Optional[str],
        side: str,
        **kwargs,
    ) -> bool:
        dataframe, _ = self.dp.get_analyzed_dataframe(pair, self.timeframe)
        if dataframe is None or len(dataframe) == 0:
            return True

        last    = dataframe.iloc[-1]
        atr     = last["atr"]
        adx     = last["adx"]

        # Reject if trend is too weak (Van Tharp quality filter)
        if pd.notna(adx) and adx < 15:
            return False

        # Reject if ATR is abnormally large (do not enter in chaos)
        if pd.notna(atr) and rate > 0:
            atr_pct = atr / rate
            if atr_pct > 0.08:   # ATR > 8% of price = too volatile
                return False

        return True
