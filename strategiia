try:
    from risk_manager import RiskManager
except Exception:
    class RiskManager:
        """
        Простой fallback-риск-менеджер.
        Используется только если файл risk_manager.py не найден.
        """

        def __init__(self, config: dict):
            self.config = config or {}
            self.risk_per_trade = float(self.config.get("risk_per_trade", 0.01))
            self.max_open_risk = float(self.config.get("max_open_risk", 0.05))
            self.open_risk = 0.0
            self.peak = 0.0

        def update_peak(self, capital: float):
            if capital is None:
                return
            self.peak = max(self.peak, float(capital))

        def can_trade(self, capital: float):
            if self.open_risk + self.risk_per_trade > self.max_open_risk:
                return (
                    False,
                    f"open_risk {self.open_risk:.2%} + new {self.risk_per_trade:.2%} "
                    f"> max {self.max_open_risk:.2%}"
                )
            return True, ""

        def add_open_risk(self, amount: float):
            self.open_risk += float(amount)

        def remove_open_risk(self, amount: float):
            self.open_risk = max(0.0, self.open_risk - float(amount))


